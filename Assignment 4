#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main()
{
    char str1[200], str2[200];
    int ch, j;

    do
    {
        printf("\n\tMENU");
        printf("\n----------------------------------\n");
        printf("1: Find Length of String");
        printf("\n2: Concatenate Strings");
        printf("\n3: Copy String");
        printf("\n4: Compare Strings");
        printf("\n5: Exit");
        printf("\n----------------------------------\n");

        printf("Enter your choice: ");
        scanf("%d", &ch);

        switch (ch)
        {
            case 1:
                printf("Enter String: ");
                scanf("%199s", str1);

                printf("Length of string: %zu\n", strlen(str1));
                break;

            case 2:
                printf("Enter First String: ");
                scanf("%99s", str1);

                printf("Enter Second String: ");
                scanf("%99s", str2);

                strcat(str1, str2);

                printf("String after concatenation: %s\n", str1);
                break;

            case 3:
                printf("Enter String 1: ");
                scanf("%199s", str1);

                printf("Enter String 2: ");
                scanf("%199s", str2);

                printf("\nBefore copying:\n");
                printf("String 1 = \"%s\"\n", str1);
                printf("String 2 = \"%s\"\n", str2);

                strcpy(str2, str1);

                printf("\nAfter copying String 1 to String 2:\n");
                printf("String 1 = \"%s\"\n", str1);
                printf("String 2 = \"%s\"\n", str2);
                break;

            case 4:
                printf("Enter First String: ");
                scanf("%199s", str1);

                printf("Enter Second String: ");
                scanf("%199s", str2);

                j = strcmp(str1, str2);

                if (j == 0)
                {
                    printf("Strings are same.\n");
                }
                else
                {
                    printf("Strings are not same.\n");
                }
                break;

            case 5:
                printf("Exiting the program.\n");
                exit(0);

            default:
                printf("Invalid input. Please enter a valid choice.\n");
        }

    } while (ch != 5);

    return 0;
}
